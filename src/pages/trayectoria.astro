---
import MainLayout from "@layouts/MainLayout.astro";

const academicItems = [
  {
    institution: "Universidad de Valparaíso",
    year: "2014",
    category: "Reconocimiento académico",
    title: "Premio al Mejor Licenciado 2014",
    description:
      "Distinción otorgada a Saúl Cancino Ahumada por su destacado rendimiento académico durante el pregrado, examen de licenciatura y memoria de grado.",
    links: [
      {
        label: "Ver publicación UV Derecho",
        url: "https://derecho.uv.cl/en-solemne-acto-se-despidio-a-la-centesima-generacion-de-egresados-de-la-escuela-de-derecho/"
      },
      {
        label: "Ver publicación Universidad de Valparaíso",
        url: "https://uv.cl/archivo-noticias-uv/6957-en-solemne-acto-se-despidio-a-la-centesima-generacion-de-egresados-de-la-escuela-de-derecho-6957"
      }
    ]
  }
];

const mediaItems = [
  {
    source: "24 Horas",
    year: "18 de febrero de 2014",
    category: "Trayectoria académica",
    title: "Preparación para examen de grado y formación jurídica",
    description:
      "Cobertura periodística sobre la preparación de Saúl Cancino para su examen de grado y su proceso de formación jurídica.",
    url: "https://www.24horas.cl/nacional/joven-empapela-su-pieza-con-materia-de-examen-de-grado-1084405"
  }
];

const publicMatterItems = [
  {
    source: "BioBioChile",
    year: "2019",
    category: "Asunto de relevancia pública",
    title: "Cobertura vinculada a Everton de Viña del Mar",
    description:
      "Cobertura periodística relacionada con acciones judiciales derivadas de incidentes ocurridos en una actividad institucional del club.",
    url: "https://www.biobiochile.cl/noticias/nacional/region-de-valparaiso/2019/06/29/everton-presenta-querella-contra-responsables-de-incidentes-en-gala-de-aniversario-del-club.shtml"
  }
];

const regionalPressItems = [
  {
    image: "/imagenes/noticia.webp",
    source: "La Estrella",
    year: "28 de abril de 2012",
    title: "Elecciones en la corporación",
    description: "Registro de prensa regional vinculado a un proceso eleccionario en la Corporación Deportiva Everton de Viña del Mar."
  },
  {
    image: "/imagenes/noticia-02.webp",
    source: "La Estrella",
    year: "25 de marzo de 2017",
    title: "Ruleteros se querellan contra violentistas",
    description: "Cobertura regional sobre una acción judicial presentada por Everton de Viña del Mar tras incidentes vinculados a una actividad deportiva."
  },
  {
    image: "/imagenes/noticia-03.webp",
    source: "El Mercurio de Valparaíso",
    year: "29 de junio de 2019",
    title: "Everton se querella contra presuntos responsables",
    description: "Cobertura de prensa sobre una querella vinculada a incidentes ocurridos en una actividad institucional del club."
  }
];

const practiceLinks = [
  {
    title: "Resolución de Controversias en Construcción y Contratación Pública",
    href: "/resolucion-controversias-construccion-contratacion-publica/",
    description:
      "Asesoría y litigación para constructoras y contratistas en conflictos derivados de contratos de obra pública y privada."
  },
  {
    title: "Asesoría legal de empresa",
    href: "/asesoria-legal-empresa/",
    description:
      "Acompañamiento jurídico para empresas que necesitan prevenir riesgos, ordenar decisiones y resolver conflictos."
  },
  {
    title: "Litigación civil y comercial",
    href: "/litigacion-civil-comercial/",
    description:
      "Representación estratégica en conflictos civiles, comerciales, contractuales y patrimoniales."
  },
  {
    title: "Defensa laboral para empleadores",
    href: "/defensa-laboral-empleador/",
    description:
      "Asesoría y defensa para empresas y empleadores ante conflictos laborales y riesgos asociados."
  }
];
---

<MainLayout
  title="Trayectoria de Saúl Cancino | Reconocimientos, prensa y experiencia jurídica"
  description="Conozca la trayectoria académica, apariciones en medios y experiencia profesional de Saúl Cancino, abogado enfocado en litigación, asesoría estratégica y resolución de asuntos jurídicos complejos."
  path="/trayectoria/"
>
  <section class="relative overflow-hidden bg-primary text-white">
    <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(15,39,82,1),rgba(15,39,82,0.95)_54%,rgba(37,38,43,0.92))]"></div>
    <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-[radial-gradient(circle_at_60%_38%,rgba(215,117,52,0.18),transparent_36%)] lg:block"></div>
    <div class="container-page relative grid gap-12 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-28">
      <div>
        <p class="inline-flex rounded-full border border-white/14 bg-white/[0.08] px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-white/82">
          Trayectoria profesional
        </p>
        <h1 class="mt-7 font-serif text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
          Trayectoria jurídica, académica y profesional
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/76 sm:text-lg sm:leading-9">
          Una mirada a la formación, reconocimientos y experiencia de Saúl Cancino, abogado dedicado a la asesoría estratégica, litigación y resolución de asuntos jurídicos complejos.
        </p>
        <a class="btn-primary mt-9" href="/contacto/">Solicitar evaluación legal</a>
      </div>

      <div class="relative">
        <div class="rounded-lg border border-white/12 bg-white/[0.07] p-6 shadow-[0_30px_90px_rgba(0,0,0,0.25)] backdrop-blur">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">Cancino Abogados</p>
          <p class="mt-5 font-serif text-3xl font-semibold leading-tight text-white">
            Validación externa, criterio técnico y experiencia aplicada a asuntos jurídicos complejos.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {["Academia", "Prensa", "Litigación"].map((item) => (
              <div class="rounded-md border border-white/10 bg-white/[0.06] p-4">
                <p class="text-sm font-bold text-white">{item}</p>
                <p class="mt-2 h-1 w-10 rounded-full bg-accent"></p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <p class="eyebrow">Perfil profesional</p>
        <h2 class="section-title">Sobre Saúl Cancino</h2>
        <p class="section-copy">
          Saúl Cancino Ahumada es abogado titulado de la Universidad de Valparaíso y Magíster en Derecho de la Empresa por la Pontificia Universidad Católica de Chile. Desde Cancino Abogados dirige una práctica enfocada en litigación, estrategia jurídica y asesoría a empresas, constructoras, contratistas, empleadores y personas que requieren resolver asuntos legales complejos con claridad y criterio empresarial.
        </p>
        <blockquote class="mt-8 rounded-lg border-l-4 border-accent bg-mist p-6 font-serif text-2xl font-semibold leading-tight text-primary shadow-[0_18px_50px_rgba(15,39,82,0.08)]">
          “Combinamos litigación, estrategia y criterio empresarial para resolver asuntos jurídicos complejos con claridad.”
        </blockquote>
      </div>

      <figure class="relative overflow-hidden rounded-lg border border-muted-blue/35 bg-primary shadow-[0_28px_78px_rgba(15,39,82,0.16)]">
        <img
          class="aspect-[4/5] w-full object-cover object-top"
          src="/images/saul-cancino-abogado.jpg"
          alt="Abogado Saúl Cancino"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
          onerror="this.onerror=null; this.src='/imagenes/Saul_cancino_abogado.webp';"
        />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-primary/95 to-transparent px-6 pb-6 pt-16">
          <p class="font-serif text-2xl font-semibold text-white">Saúl Cancino Ahumada</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-[0.18em] text-accent">Abogado director</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-mist py-20 lg:py-24">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow">Reconocimientos</p>
        <h2 class="section-title">Trayectoria académica y reconocimientos</h2>
        <p class="section-copy">
          Durante su etapa universitaria, Saúl Cancino Ahumada fue distinguido con el Premio al Mejor Licenciado 2014 por la Universidad de Valparaíso. Esta distinción reconoció su óptimo rendimiento académico durante los años de pregrado, su examen de licenciatura rendido durante 2014 y su memoria de grado.
        </p>
      </div>

      <div class="mt-10 grid gap-6">
        {academicItems.map((item) => (
          <article class="overflow-hidden rounded-lg border border-primary/15 bg-white shadow-[0_24px_70px_rgba(15,39,82,0.1)]">
            <div class="grid gap-0 lg:grid-cols-[0.34fr_0.66fr]">
              <div class="bg-primary p-7 text-white">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">{item.category}</p>
                <p class="mt-8 font-serif text-5xl font-semibold">{item.year}</p>
                <p class="mt-3 text-sm font-semibold text-white/72">{item.institution}</p>
              </div>
              <div class="p-7 lg:p-9">
                <h3 class="font-serif text-3xl font-semibold text-night">{item.title}</h3>
                <p class="mt-4 text-base leading-8 text-primary-soft">{item.description}</p>
                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                  {item.links.map((link) => (
                    <a class="btn-outline" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
        <div>
          <p class="eyebrow">Validación externa</p>
          <h2 class="section-title">Menciones en medios</h2>
        </div>
        <p class="section-copy mt-0">
          Además de su trayectoria académica, Saúl Cancino ha sido mencionado en medios de comunicación por hitos vinculados a su formación jurídica y desempeño profesional. Estas publicaciones permiten contextualizar su recorrido desde fuentes externas.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {mediaItems.map((item) => (
          <article class="rounded-lg border border-muted-blue/35 bg-white p-7 shadow-[0_18px_52px_rgba(15,39,82,0.09)]">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-accent">{item.category} · {item.year}</p>
            <h3 class="mt-5 font-serif text-2xl font-semibold text-night">{item.title}</h3>
            <p class="mt-4 text-sm font-semibold text-primary">{item.source}</p>
            <p class="mt-3 text-sm leading-7 text-primary-soft">{item.description}</p>
            <a class="mt-6 inline-flex text-sm font-black text-primary hover:text-accent-dark" href={item.url} target="_blank" rel="noopener noreferrer">Ver publicación →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary py-20 text-white lg:py-24">
    <div class="container-page">
      <div class="max-w-4xl">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">Asuntos públicos</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Experiencia y asuntos de relevancia pública</h2>
        <p class="mt-5 text-base leading-8 text-white/72">
          Cancino Abogados también ha estado vinculado a asuntos jurídicos que han tenido cobertura en medios regionales y nacionales. Este tipo de casos refleja experiencia práctica en escenarios donde la estrategia legal, el análisis de antecedentes y el criterio jurídico son determinantes.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {publicMatterItems.map((item) => (
          <article class="rounded-lg border border-white/12 bg-white p-7 text-primary shadow-[0_24px_70px_rgba(0,0,0,0.18)]">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-accent">{item.category} · {item.year}</p>
            <h3 class="mt-5 font-serif text-2xl font-semibold text-night">{item.title}</h3>
            <p class="mt-4 text-sm font-semibold text-primary">{item.source}</p>
            <p class="mt-3 text-sm leading-7 text-primary-soft">{item.description}</p>
            <a class="mt-6 inline-flex text-sm font-black text-primary hover:text-accent-dark" href={item.url} target="_blank" rel="noopener noreferrer">Ver publicación →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist py-20 lg:py-24">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow">Archivo visual</p>
        <h2 class="section-title">Prensa regional y archivos de cobertura</h2>
        <p class="section-copy">
          Algunas apariciones en prensa regional pueden encontrarse en medios con acceso restringido o mediante registros visuales conservados por el estudio. Esta sección quedará preparada para incorporar imágenes, recortes o capturas autorizadas de publicaciones relevantes.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {regionalPressItems.map((item) => (
          <article class="overflow-hidden rounded-lg border border-muted-blue/35 bg-white shadow-[0_18px_52px_rgba(15,39,82,0.09)]">
            <button
              class="group relative block aspect-[4/3] w-full overflow-hidden bg-primary text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              type="button"
              data-press-zoom
              data-image={item.image}
              data-title={item.title}
              data-source={`${item.source} · ${item.year}`}
              aria-label={`Ampliar imagen de prensa: ${item.title}`}
            >
              <img
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
                onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden'); this.nextElementSibling?.classList.add('flex'); this.closest('button')?.setAttribute('disabled', 'true');"
              />
              <div class="hidden h-full items-center justify-center px-6 text-center text-sm font-bold uppercase tracking-[0.16em] text-white/72">
                Imagen de prensa por agregar
              </div>
              <span class="absolute bottom-4 right-4 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-primary shadow-[0_14px_34px_rgba(0,0,0,0.18)] transition group-hover:bg-accent group-hover:text-white">
                Ampliar
                <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                  <path d="M8 4H4v4M4 4l6 6M16 4h4v4M20 4l-6 6M8 20H4v-4M4 20l6-6M16 20h4v-4M20 20l-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </button>
            <div class="p-6">
              <p class="text-xs font-black uppercase tracking-[0.18em] text-accent">{item.source} · {item.year}</p>
              <h3 class="mt-4 font-serif text-xl font-semibold text-night">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-primary-soft">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div
    class="fixed inset-0 z-[90] hidden bg-primary/92 p-4 backdrop-blur-sm"
    data-press-lightbox
    role="dialog"
    aria-modal="true"
    aria-labelledby="press-lightbox-title"
  >
    <button class="absolute inset-0 cursor-zoom-out" type="button" data-press-close aria-label="Cerrar imagen ampliada"></button>
    <div class="relative mx-auto flex h-full max-w-6xl flex-col">
      <div class="mb-3 flex items-center justify-between gap-4 rounded-lg border border-white/10 bg-white p-4 shadow-[0_24px_70px_rgba(0,0,0,0.24)]">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-accent" data-press-source></p>
          <h2 id="press-lightbox-title" class="mt-1 font-serif text-xl font-semibold leading-tight text-primary" data-press-title></h2>
        </div>
        <button class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-white transition hover:bg-accent-dark" type="button" data-press-close aria-label="Cerrar imagen ampliada">
          <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <div class="relative min-h-0 flex-1 overflow-auto rounded-lg border border-white/12 bg-white p-3 shadow-[0_30px_90px_rgba(0,0,0,0.35)]">
        <img class="mx-auto block h-auto max-w-none cursor-zoom-in select-none rounded-md" data-press-image alt="" />
      </div>
      <p class="mt-3 text-center text-xs font-semibold uppercase tracking-[0.16em] text-white/70">
        Use scroll para revisar la imagen ampliada. Presione Escape para cerrar.
      </p>
    </div>
  </div>

  <section class="bg-white py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
        <div>
          <p class="eyebrow">Experiencia aplicada</p>
          <h2 class="section-title">Áreas vinculadas a esta trayectoria</h2>
        </div>
        <p class="section-copy mt-0">
          La experiencia profesional de Cancino Abogados se vincula directamente con áreas donde el análisis jurídico, la estrategia procesal y el conocimiento del negocio son fundamentales.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {practiceLinks.map((item) => (
          <a class="group rounded-lg border border-muted-blue/35 bg-white p-6 shadow-[0_16px_46px_rgba(15,39,82,0.08)] transition hover:-translate-y-1 hover:border-accent/70 hover:shadow-[0_24px_68px_rgba(15,39,82,0.14)]" href={item.href}>
            <h3 class="font-serif text-2xl font-semibold leading-tight text-night">{item.title}</h3>
            <p class="mt-4 text-sm leading-7 text-primary-soft">{item.description}</p>
            <span class="mt-6 inline-flex text-sm font-black text-primary transition group-hover:text-accent-dark">Ver área →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary py-16 text-white">
    <div class="container-page grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <h2 class="font-serif text-3xl font-semibold text-white lg:text-4xl">¿Necesita asesoría en un asunto jurídico complejo?</h2>
        <p class="mt-4 max-w-3xl text-base leading-8 text-white/72">
          Conversemos sobre su caso y evaluemos el mejor camino legal con una mirada estratégica, técnica y orientada a decisiones.
        </p>
      </div>
      <a class="btn-primary bg-accent hover:bg-accent-dark" href="/contacto/">Solicitar evaluación legal</a>
    </div>
  </section>
</MainLayout>

<script>
  const lightbox = document.querySelector("[data-press-lightbox]");
  const lightboxImage = document.querySelector("[data-press-image]");
  const lightboxTitle = document.querySelector("[data-press-title]");
  const lightboxSource = document.querySelector("[data-press-source]");
  const zoomButtons = document.querySelectorAll("[data-press-zoom]");
  const closeButtons = document.querySelectorAll("[data-press-close]");

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLElement)) return;
    lightbox.classList.add("hidden");
    document.body.style.overflow = "";
  };

  zoomButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (
        !(lightbox instanceof HTMLElement) ||
        !(lightboxImage instanceof HTMLImageElement) ||
        !(lightboxTitle instanceof HTMLElement) ||
        !(lightboxSource instanceof HTMLElement)
      ) {
        return;
      }

      if (!(button instanceof HTMLElement)) return;

      const image = button.dataset.image ?? "";
      const title = button.dataset.title ?? "Imagen de prensa";
      const source = button.dataset.source ?? "";

      lightboxImage.src = image;
      lightboxImage.alt = title;
      lightboxTitle.textContent = title;
      lightboxSource.textContent = source;
      lightbox.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    });
  });

  closeButtons.forEach((button) => button.addEventListener("click", closeLightbox));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLightbox();
  });
</script>
