---
import CTASection from "@components/CTASection.astro";
import FAQ from "@components/FAQ.astro";
import PageHero from "@components/PageHero.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import ServiceCard from "@components/ServiceCard.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { locationServices, locations, type LocationLanding } from "@data/locations";
import { services, type Service } from "@data/services";
import { site } from "@data/site";
import { breadcrumbSchema, faqPageSchema, localBusinessSchema, servicePageSchema } from "@utils/schema";
import { buildCanonical } from "@utils/seo";

type PageProps =
  | { kind: "service"; item: Service; currentSlug: string }
  | { kind: "location"; item: LocationLanding; currentSlug: string };

export function getStaticPaths() {
  return [
    ...services.map((service) => ({
      params: { slug: service.slug },
      props: { kind: "service", item: service, currentSlug: service.slug }
    })),
    ...locations
      .filter((location) => !location.isPrimaryMarket)
      .map((location) => ({
        params: { slug: location.slug },
        props: { kind: "location", item: location, currentSlug: location.slug }
      }))
  ];
}

const props = Astro.props as PageProps;
const serviceItem = props.kind === "service" ? props.item : null;
const locationItem = props.kind === "location" ? props.item : null;
const isService = serviceItem !== null;
const item = props.item;
const canonicalPath = `/${item.slug}/`;
const pageTitle = item.h1;
const seoTitle = item.titleTag;
const description = item.metaDescription;
const crumbs = [
  { label: "Inicio", href: "/" },
  { label: pageTitle }
];
const schema = [
  serviceItem ? servicePageSchema(serviceItem, canonicalPath) : localBusinessSchema(),
  faqPageSchema(item.faqs),
  breadcrumbSchema([
    { name: "Inicio", url: buildCanonical("/") },
    { name: pageTitle, url: buildCanonical(canonicalPath) }
  ])
];

const relatedServices = serviceItem
  ? services.filter((service) => service.slug !== serviceItem.slug).slice(0, 3)
  : locationServices;

// TODO: Reemplazar estas URLs temporales por imágenes definitivas en /public/images/.
const serviceHeroImages: Record<string, string> = {
  "resolucion-controversias-construccion-contratacion-publica":
    "https://images.pexels.com/photos/2760243/pexels-photo-2760243.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "asesoria-legal-empresa":
    "https://images.pexels.com/photos/3184465/pexels-photo-3184465.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "litigacion-civil-comercial":
    "https://images.pexels.com/photos/5668473/pexels-photo-5668473.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "defensa-laboral-empleador":
    "https://images.pexels.com/photos/7841466/pexels-photo-7841466.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "desarrollo-inmobiliario-estructuracion-proyectos":
    "https://images.pexels.com/photos/8293778/pexels-photo-8293778.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "gobierno-corporativo-estructuras-societarias":
    "https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "contratos-estrategicos-negociacion-empresarial":
    "https://images.pexels.com/photos/5668858/pexels-photo-5668858.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "negociacion-resolucion-conflictos":
    "https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&cs=tinysrgb&w=1800",
  "compliance-corporativo":
    "https://images.pexels.com/photos/8296981/pexels-photo-8296981.jpeg?auto=compress&cs=tinysrgb&w=1800"
};

const locationHeroImages: Record<string, string> = {
  "abogado-santiago": "/imagenes/Santiago.webp",
  "abogado-quillota": "/imagenes/Quillota.webp",
  "abogado-san-felipe": "/imagenes/San felipe.webp"
};

const defaultHeroImage =
  "https://images.pexels.com/photos/7841466/pexels-photo-7841466.jpeg?auto=compress&cs=tinysrgb&w=1800";

const heroImage = serviceItem
  ? serviceHeroImages[serviceItem.slug] ?? defaultHeroImage
  : locationItem
    ? locationHeroImages[locationItem.slug] ?? defaultHeroImage
    : defaultHeroImage;

const heroSubtitle = serviceItem ? serviceItem.intro : locationItem?.summary;
---

<MainLayout title={seoTitle} description={description} path={canonicalPath} schemas={schema}>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow={item.keyword}
    title={pageTitle}
    subtitle={heroSubtitle}
    backgroundImage={heroImage}
    ctaText="Solicitar evaluación legal"
    ctaHref={site.whatsapp}
    ctaExternal
    secondaryCtaText="Contactar a Cancino Abogados"
    secondaryCtaHref="/contacto/"
  />

  {serviceItem ? (
    <section class="py-20">
      <div class="container-page grid gap-12 lg:grid-cols-[0.72fr_0.28fr]">
        <article>
          <h2 class="font-serif text-3xl font-semibold text-night">{serviceItem.specializedHeading}</h2>
          <p class="mt-5 text-base leading-8 text-primary-soft">{serviceItem.intro}</p>
          {serviceItem.coverage && <p class="mt-4 text-base leading-8 text-primary-soft">{serviceItem.coverage}</p>}

          <section class="mt-12">
            <h2 class="font-serif text-2xl font-semibold text-night">{serviceItem.casesHeading ?? "¿En qué casos puede necesitar este servicio?"}</h2>
            <ul class="mt-6 grid gap-4 md:grid-cols-2">
              {serviceItem.cases.map((caseItem, index) => (
                <li class="group flex min-h-28 gap-4 rounded-md border border-primary/15 bg-white p-5 shadow-[0_16px_40px_rgba(15,39,82,0.08)] transition duration-300 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-[0_22px_55px_rgba(15,39,82,0.12)]">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary text-xs font-bold text-white transition group-hover:bg-accent-dark">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="text-sm font-semibold leading-7 text-text-dark">{caseItem}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-12">
            <h2 class="font-serif text-2xl font-semibold text-night">{serviceItem.approachHeading ?? "Cómo trabaja Cancino Abogados este tipo de casos"}</h2>
            <div class="mt-6">
              <ProcessSteps />
            </div>
            <ul class="mt-6 grid gap-4 md:grid-cols-2">
              {serviceItem.approach.map((step, index) => (
                <li class="relative overflow-hidden rounded-md border border-muted-blue/35 bg-mist p-5 shadow-[0_14px_36px_rgba(15,39,82,0.06)]">
                  <div class="absolute inset-y-0 left-0 w-1 bg-accent"></div>
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Acción {index + 1}</p>
                  <p class="mt-3 text-sm font-semibold leading-7 text-primary">{step}</p>
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-12 overflow-hidden rounded-md border border-primary/10 bg-primary p-7 text-white shadow-[0_24px_70px_rgba(15,39,82,0.16)]">
            <h2 class="font-serif text-2xl font-semibold text-white">Beneficios de contar con asesoría legal oportuna</h2>
            <ul class="mt-6 grid gap-4 md:grid-cols-3">
              {serviceItem.benefits.map((benefit) => (
                <li class="rounded-md border border-white/12 bg-white/[0.08] p-5 text-sm font-semibold leading-7 text-white/88">
                  <span class="mb-4 block h-1 w-10 rounded-full bg-accent"></span>
                  {benefit}
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-12">
            <h2 class="font-serif text-2xl font-semibold text-night">Servicios relacionados</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-3">
              {relatedServices.map((service) => (
                <ServiceCard title={service.title} summary={service.summary} href={`/${service.slug}/`} />
              ))}
            </div>
          </section>

          <section class="mt-12">
            <h2 class="font-serif text-2xl font-semibold text-night">Preguntas frecuentes sobre {serviceItem.title.toLowerCase()}</h2>
            <div class="mt-6">
              <FAQ items={serviceItem.faqs} />
            </div>
          </section>
        </article>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-md border border-muted-blue/35 bg-white p-6 shadow-soft">
            <h2 class="font-serif text-xl font-semibold text-night">Solicite una evaluación legal</h2>
            <p class="mt-3 text-sm leading-7 text-primary-soft">
              Comparta sus antecedentes para evaluar riesgos, alternativas y próximos pasos.
            </p>
            <a class="btn-primary mt-5 w-full" href={site.whatsapp} target="_blank" rel="noreferrer">Hablar con un abogado</a>
          </div>
        </aside>
      </div>
    </section>
  ) : locationItem ? (
    <section class="py-20">
      <div class="container-page">
        <article>
          <div class="max-w-5xl">
            <h2 class="font-serif text-3xl font-semibold text-night lg:text-4xl">{locationItem.contentHeading}</h2>
            {locationItem.content.map((paragraph) => (
              <p class="mt-5 text-base leading-8 text-primary-soft lg:text-lg lg:leading-9">{paragraph}</p>
            ))}
          </div>

          <section class="mt-12 rounded-lg border border-primary/10 bg-mist p-6 shadow-[0_18px_52px_rgba(15,39,82,0.07)]">
            <div class="max-w-3xl">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-accent">Servicios disponibles</p>
              <h2 class="mt-3 font-serif text-2xl font-semibold text-night">{locationItem.servicesHeading}</h2>
              <p class="mt-4 text-sm leading-7 text-primary-soft">
                Cancino Abogados puede apoyar en {locationItem.city} con todas las áreas de práctica del estudio, desde asesoría preventiva hasta resolución de conflictos complejos.
              </p>
            </div>
            <ul class="mt-6 grid gap-3 md:grid-cols-2">
              {locationItem.serviceItems.map((serviceItem) => (
                <li class="rounded-md border border-primary/12 bg-white px-4 py-3 text-sm font-semibold leading-7 text-text-dark shadow-[0_12px_32px_rgba(15,39,82,0.06)]">
                  {serviceItem}
                </li>
              ))}
            </ul>
            <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {locationServices.map((service) => (
                <ServiceCard title={service.title} summary={service.summary} href={`/${service.slug}/`} />
              ))}
            </div>
          </section>

          {locationItem.whyHeading && locationItem.whyText && (
            <section class="mt-12 rounded-lg border border-primary/15 bg-white p-7 shadow-soft">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">Criterio local</p>
              <h2 class="mt-3 font-serif text-2xl font-semibold text-night">{locationItem.whyHeading}</h2>
              <p class="mt-4 text-base leading-8 text-primary-soft">{locationItem.whyText}</p>
            </section>
          )}

          <section class="mt-12 overflow-hidden rounded-lg border border-primary/15 bg-primary text-white shadow-[0_28px_80px_rgba(15,39,82,0.18)]">
            <div class="relative p-6 sm:p-8 lg:p-10">
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.08),transparent_46%,rgba(215,117,52,0.12))]"></div>
              <div class="pointer-events-none absolute -right-20 -top-24 h-56 w-56 rounded-full border border-white/10"></div>

              <div class="relative grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
                <div>
                  <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">Evaluación oportuna</p>
                  <h2 class="mt-4 font-serif text-3xl font-semibold leading-tight text-white lg:text-4xl">
                    ¿Cuándo debería contactar a un abogado en {locationItem.city}?
                  </h2>
                  <p class="mt-5 text-sm leading-7 text-white/72">
                    Si una decisión puede afectar contratos, patrimonio, continuidad operacional o responsabilidades como empleador, conviene revisar antecedentes antes de actuar.
                  </p>
                </div>

                <ul class="grid gap-4 md:grid-cols-2">
                  {locationItem.highlights.map((highlight, index) => (
                    <li class="group relative overflow-hidden rounded-md border border-white/12 bg-white p-5 text-primary shadow-[0_18px_46px_rgba(0,0,0,0.16)] transition duration-300 hover:-translate-y-0.5 hover:border-accent/70">
                      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-accent via-accent-dark to-primary"></div>
                      <div class="flex gap-4">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary text-xs font-black text-white transition group-hover:bg-accent-dark">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <p class="text-sm font-semibold leading-7 text-text-dark">{highlight}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <section class="mt-12">
            <h2 class="font-serif text-2xl font-semibold text-night">Preguntas frecuentes sobre abogados en {locationItem.city}</h2>
            <div class="mt-6">
              <FAQ items={locationItem.faqs} />
            </div>
          </section>
        </article>
      </div>
    </section>
  ) : null}

  <CTASection title={serviceItem ? "Solicite una evaluación legal" : `Solicite una evaluación legal en ${locationItem?.city ?? ""}`} />
</MainLayout>
