---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import CTASection from "@components/CTASection.astro";
import ServiceCard from "@components/ServiceCard.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { services } from "@data/services";
import { attorneySchema, breadcrumbSchema, legalServiceSchema } from "@utils/schema";
import { buildCanonical } from "@utils/seo";

const academicItems = [
  "Abogado — Universidad de Valparaíso (Mejor Licenciado 2014)",
  "Magíster en Derecho de la Empresa, LL.M. — Pontificia Universidad Católica de Chile",
  "Atención profesional en español e inglés"
];

const practiceAreas = [
  "Litigación civil y comercial",
  "Derecho inmobiliario y desarrollo de proyectos",
  "Defensa laboral para empleadores",
  "Resolución de controversias en construcción y contratación pública",
  "Asesoría legal permanente a empresas",
  "Gobierno corporativo y estructuras societarias",
  "Contratos estratégicos y negociación empresarial",
  "Compliance corporativo"
];

const schema = [
  legalServiceSchema(),
  attorneySchema(),
  breadcrumbSchema([
    { name: "Inicio", url: buildCanonical("/") },
    { name: "Nosotros", url: buildCanonical("/nosotros/") }
  ])
];
---

<MainLayout
  title="Saúl Cancino — Abogado en Viña del Mar | Cancino Abogados"
  description="Conoce a Saúl Cancino, abogado titulado de la Universidad de Valparaíso y Magíster LL.M. UC. Más de 10 años asesorando empresas y personas en Viña del Mar y la región."
  path="/nosotros/"
  schema={schema}
>
  <section class="bg-mist py-14">
    <div class="container-page">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Nosotros" }]} />
      <div class="mt-8 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div>
          <p class="eyebrow">Cancino Abogados</p>
          <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-night sm:text-5xl lg:text-6xl">
            Saúl Cancino — Abogado en Viña del Mar
          </h1>
          <p class="mt-6 text-base leading-8 text-primary-soft">
            Soy abogado titulado de la Universidad de Valparaíso, donde fui reconocido como el mejor licenciado de mi generación en 2014. Posteriormente obtuve el grado de Magíster en Derecho de la Empresa, mención LL.M., en la Pontificia Universidad Católica de Chile.
          </p>
          <p class="mt-4 text-base leading-8 text-primary-soft">
            Desde 2014 dirijo Cancino Abogados, estudio jurídico enfocado en asesoría estratégica a empresas y personas en Viña del Mar, Santiago, Quillota, San Felipe y el Valle del Aconcagua.
          </p>
        </div>

        <figure class="relative overflow-hidden rounded-md border border-primary/10 bg-primary p-4 shadow-[0_30px_80px_rgba(15,39,82,0.18)]">
          <img
            class="aspect-[4/5] w-full rounded-sm object-cover object-top"
            src="/imagenes/Abogado-cancino.webp"
            alt="Abogado Saúl Cancino"
            width="900"
            height="1125"
            loading="eager"
            decoding="async"
          />
          <figcaption class="absolute bottom-7 left-7 max-w-xs rounded-md border border-white/20 bg-white p-5 text-primary shadow-[0_20px_50px_rgba(0,0,0,0.18)]">
            <p class="text-sm font-semibold leading-7">
              Asesoría estratégica, rigurosa y personalizada para decisiones legales relevantes.
            </p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Enfoque profesional</p>
        <h2 class="section-title">Mi enfoque de trabajo</h2>
      </div>
      <div class="space-y-5 text-base leading-8 text-primary-soft">
        <p>
          Cada cliente enfrenta una realidad distinta. Por eso no ofrezco soluciones genéricas: analizo cada situación en profundidad y diseño una estrategia legal que equilibra el resultado esperado con los recursos y tiempos disponibles.
        </p>
        <p>
          Mi enfoque está orientado a la prevención de riesgos, la estructuración jurídica sólida de negocios y la resolución eficiente de conflictos, con un estándar técnico alto y atención personalizada.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-mist py-20">
    <div class="container-page grid gap-8 lg:grid-cols-2">
      <div class="rounded-md border border-primary/10 bg-white p-7 shadow-soft">
        <p class="eyebrow">Formación académica</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-night">Formación académica</h2>
        <ul class="mt-6 grid gap-4">
          {academicItems.map((item) => (
            <li class="rounded-md border border-muted-blue/35 bg-mist px-4 py-4 text-sm font-semibold leading-7 text-text-dark">
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-md border border-primary/10 bg-primary p-7 text-white shadow-[0_24px_70px_rgba(15,39,82,0.16)]">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-accent">Áreas de práctica</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-white">Áreas de práctica</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {practiceAreas.map((item) => (
            <li class="rounded-md border border-white/12 bg-white/[0.08] px-4 py-3 text-sm font-semibold leading-7 text-white/88">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow">Servicios relacionados</p>
        <h2 class="section-title">Asesoría legal para empresas y personas</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((service) => (
          <ServiceCard title={service.title} summary={service.summary} href={`/${service.slug}/`} />
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Solicite una evaluación legal" text="Conversemos sobre su caso y evaluemos el mejor camino legal con una mirada estratégica." />
</MainLayout>
