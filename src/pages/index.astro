---
import AttorneyProfile from "@components/AttorneyProfile.astro";
import CTASection from "@components/CTASection.astro";
import FAQSection from "@components/FAQSection.astro";
import Hero from "@components/Hero.astro";
import LocationCard from "@components/LocationCard.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import ServicesCarousel from "@components/ServicesCarousel.astro";
import TestimonialsCarousel from "@components/TestimonialsCarousel.astro";
import TrustSection from "@components/TrustSection.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { faqs } from "@data/faqs";
import { locations } from "@data/locations";
import { services } from "@data/services";
import { site } from "@data/site";
import { attorneySchema, faqPageSchema, legalServiceSchema, localBusinessSchema } from "@utils/schema";

const schema = [legalServiceSchema(), localBusinessSchema(), attorneySchema(), faqPageSchema(faqs)];
---

<MainLayout
  title="Abogado en Viña del Mar | Cancino Abogados"
  description="Abogado en Viña del Mar con más de 10 años de experiencia. Derecho civil, comercial, inmobiliario y laboral para empresas y personas. Saúl Cancino — Magíster LL.M. UC."
  path="/"
  schema={schema}
>
  <Hero />

  <section id="servicios" class="scroll-mt-24 py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="eyebrow">Servicios principales</p>
          <h2 class="section-title">Áreas de práctica orientadas a resultados concretos</h2>
        </div>
        <p class="text-base leading-8 text-primary-soft lg:max-w-2xl">
          Desde litigios complejos hasta la estructuración jurídica de tu empresa, Cancino Abogados ofrece soluciones legales a medida. Asesoría estratégica, con enfoque en resultados concretos.
        </p>
      </div>
      <div class="mt-12">
        <ServicesCarousel services={services} />
      </div>
    </div>
  </section>

  <AttorneyProfile />

  <section class="relative overflow-hidden bg-mist py-20 lg:py-24">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/70 to-transparent"></div>
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
        <div>
          <p class="eyebrow">Dónde atendemos</p>
          <h2 class="section-title">Abogado en Viña del Mar, con atención en Santiago, Quillota y San Felipe</h2>
        </div>
        <p class="section-copy mt-0 lg:max-w-2xl">
          Atención legal para empresas, constructoras, contratistas, empleadores, propietarios e inversionistas que necesitan orientación estratégica, revisión documental o defensa en conflictos relevantes.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {locations.map((location) => (
          <LocationCard city={location.city} summary={location.summary} href={`/${location.slug}/`} />
        ))}
      </div>
    </div>
  </section>

  <TrustSection />

  <TestimonialsCarousel />

  <section class="py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="eyebrow">Proceso de atención</p>
          <h2 class="section-title">Un método claro desde la primera conversación</h2>
        </div>
        <p class="section-copy">
          La asesoría busca reducir incertidumbre: primero entendemos el problema, luego evaluamos alternativas y finalmente definimos una ruta de acción proporcional al caso.
        </p>
      </div>
      <div class="mt-12">
        <ProcessSteps />
      </div>
    </div>
  </section>

  <FAQSection />

  <CTASection
    title="Solicite una evaluación legal"
    text={`Escríbanos a ${site.email} o coordine una consulta para revisar sus antecedentes y próximos pasos.`}
  />
</MainLayout>
