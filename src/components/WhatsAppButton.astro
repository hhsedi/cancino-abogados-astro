---
import { site } from "@data/site";
---

<a
  class="whatsapp-float"
  href={site.whatsapp}
  target="_blank"
  rel="noreferrer"
  aria-label="Contactar por WhatsApp"
>
  <span class="whatsapp-float__pulse" aria-hidden="true"></span>
  <span class="whatsapp-float__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" role="img">
      <path
        d="M19.05 4.91A9.79 9.79 0 0 0 12.07 2C6.65 2 2.25 6.4 2.25 11.82c0 1.72.45 3.4 1.3 4.88L2.17 22l5.43-1.32a9.8 9.8 0 0 0 4.47 1.08h.01c5.42 0 9.82-4.4 9.82-9.82a9.78 9.78 0 0 0-2.85-7.03Zm-6.98 15.17h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.22.78.82-3.13-.2-.32a8.12 8.12 0 1 1 7.04 3.98Zm4.45-6.08c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.42-1.34-1.66-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
      />
    </svg>
  </span>
  <span class="whatsapp-float__label">WhatsApp</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: clamp(1rem, 2vw, 1.5rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.55rem 1rem 0.55rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(15, 39, 82, 0.98), rgba(15, 39, 82, 0.9)),
      #0f2752;
    color: #fff;
    box-shadow: 0 22px 60px rgba(15, 39, 82, 0.28), 0 10px 24px rgba(37, 211, 102, 0.18);
    text-decoration: none;
    transform: translateZ(0);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .whatsapp-float::before {
    content: "";
    position: absolute;
    inset: -0.25rem;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(37, 211, 102, 0.32), rgba(215, 117, 52, 0.16));
    opacity: 0.38;
    filter: blur(12px);
    transition: opacity 180ms ease;
  }

  .whatsapp-float__pulse {
    position: absolute;
    inset: 0.25rem;
    border-radius: inherit;
    border: 1px solid rgba(37, 211, 102, 0.34);
    opacity: 0.7;
    animation: whatsapp-pulse 2.6s ease-out infinite;
    pointer-events: none;
  }

  .whatsapp-float__icon {
    position: relative;
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 999px;
    background: linear-gradient(135deg, #25d366, #1fb456);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 10px 22px rgba(37, 211, 102, 0.25);
  }

  .whatsapp-float__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }

  .whatsapp-float__label {
    position: relative;
    padding-right: 0.2rem;
    font-size: 0.88rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .whatsapp-float:hover {
    border-color: rgba(37, 211, 102, 0.45);
    box-shadow: 0 28px 72px rgba(15, 39, 82, 0.34), 0 12px 30px rgba(37, 211, 102, 0.22);
    transform: translateY(-2px);
  }

  .whatsapp-float:hover::before {
    opacity: 0.62;
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid rgba(37, 211, 102, 0.42);
    outline-offset: 4px;
  }

  @keyframes whatsapp-pulse {
    0% {
      opacity: 0.55;
      transform: scale(0.98);
    }
    70% {
      opacity: 0;
      transform: scale(1.18);
    }
    100% {
      opacity: 0;
      transform: scale(1.18);
    }
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      width: 3.7rem;
      height: 3.7rem;
      min-height: 3.7rem;
      padding: 0;
      justify-content: center;
      border-color: rgba(255, 255, 255, 0.28);
    }

    .whatsapp-float__icon {
      width: 2.85rem;
      height: 2.85rem;
    }

    .whatsapp-float__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float,
    .whatsapp-float::before {
      transition: none;
    }

    .whatsapp-float__pulse {
      animation: none;
    }
  }
</style>
