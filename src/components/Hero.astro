---
import { site } from "@data/site";

const focusAreas = [
  ["Empresas", "Contratos estratégicos, gobierno corporativo y continuidad operacional."],
  ["Construcción", "Controversias de obra, contratación pública y reclamaciones."],
  ["Patrimonio", "Derecho inmobiliario, litigios civiles y decisiones de inversión."]
];

const trustMetrics = [
  ["+10", "años de experiencia en derecho civil y comercial"],
  ["+80", "de reseñas de 5 estrellas en Google"],
  ["4", "ciudades de atención: Viña del Mar, Santiago, Quillota y San Felipe"],
  ["ES/EN", "atención profesional en español e inglés"]
];
---

<section class="dark-section relative overflow-hidden bg-primary text-white">
  <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(15,39,82,1),rgba(15,39,82,0.96)_52%,rgba(37,38,43,0.92))]"></div>
  <div class="absolute inset-y-0 right-0 hidden w-1/2 bg-[radial-gradient(circle_at_58%_35%,rgba(215,117,52,0.18),transparent_34%)] lg:block"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-accent/35"></div>

  <div class="container-page relative grid min-h-[calc(100vh-5rem)] items-center gap-12 py-16 lg:grid-cols-[0.95fr_1.05fr] lg:py-20">
    <div class="max-w-3xl">
      <div class="hero-reveal inline-flex items-center gap-3 rounded-full border border-white/14 bg-white/[0.08] px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/82">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Estudio jurídico en Viña del Mar
      </div>

      <h1 class="hero-reveal hero-reveal-delay-1 mt-7 font-serif text-4xl font-semibold leading-tight tracking-normal sm:text-5xl lg:text-6xl">
        Abogado en Viña del Mar
      </h1>

      <p class="hero-reveal hero-reveal-delay-2 mt-6 max-w-2xl text-base leading-8 text-white/76 sm:text-lg sm:leading-9">
        Cancino Abogados asesora a empresas y personas en Viña del Mar, Santiago, Quillota y San Felipe. Más de 10 años resolviendo conflictos, estructurando negocios y protegiendo los intereses de nuestros clientes.
      </p>

      <div class="hero-reveal hero-reveal-delay-3 mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href="/contacto/">Agendar consulta</a>
        <a class="btn-secondary" href="#servicios">Ver servicios</a>
      </div>

      <div class="hero-reveal hero-reveal-delay-4 mt-10 grid gap-4 border-t border-white/12 pt-8 sm:grid-cols-3">
        {focusAreas.map(([title, text]) => (
          <div>
            <p class="text-sm font-bold text-white">{title}</p>
            <p class="mt-1 text-xs leading-6 text-white/60">{text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-reveal hero-reveal-delay-2 relative mx-auto w-full max-w-[32rem] lg:ml-auto">
      <div class="absolute -left-5 top-8 hidden h-24 w-24 border-l border-t border-white/18 lg:block"></div>
      <div class="absolute -right-5 -top-5 h-28 w-28 rounded-md bg-accent/14"></div>
      <figure class="relative overflow-hidden rounded-md border border-white/14 bg-white/[0.06] shadow-[0_30px_90px_rgba(0,0,0,0.28)]">
        <img
          class="aspect-[4/5] w-full object-cover object-top"
          src="/imagenes/Abogado-cancino.webp"
          alt="Saúl Cancino, abogado director de Cancino Abogados"
          width="900"
          height="1125"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary via-primary/28 to-white/10 mix-blend-multiply"></div>
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-primary via-primary/72 to-transparent px-6 pb-7 pt-36 sm:px-8 sm:pb-8">
          <div class="w-full text-left">
            <p class="max-w-[28rem] text-3xl font-semibold leading-[1.04] tracking-normal text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.55)] sm:text-4xl">
              Saúl Cancino<br />Ahumada
            </p>
            <p class="mt-3 w-full text-xs font-semibold uppercase tracking-[0.28em] text-accent drop-shadow-[0_1px_5px_rgba(0,0,0,0.55)] sm:text-sm">{site.lawyer.title}</p>
          </div>
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-white text-primary">
    <div class="container-page py-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-serif text-2xl font-semibold text-night">Números que generan confianza</h2>
        <p class="mt-3 text-sm leading-7 text-primary-soft">
          Cada número refleja un cliente que confió en nosotros y un problema que resolvimos. El resultado que buscas ya lo hemos logrado antes.
        </p>
      </div>
      <div class="mt-7 grid gap-0 divide-y divide-muted-blue/30 text-center sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
        {trustMetrics.map(([value, label]) => (
          <div class="px-4 py-4">
            <p class="font-serif text-3xl font-semibold leading-none text-primary">{value}</p>
            <p class="mx-auto mt-2 max-w-[15rem] text-[0.72rem] font-bold uppercase tracking-[0.14em] text-primary-soft">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
