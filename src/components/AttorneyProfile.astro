---
import { site } from "@data/site";

const credentials = [
  ["Formación", "Universidad de Valparaíso"],
  ["Postgrado", "Magíster en Derecho de la Empresa UC"],
  ["Idiomas", "Español e inglés"]
];
---

<section class="bg-mist py-20 lg:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
    <div class="relative mx-auto w-full max-w-[34rem] lg:mx-0">
      <div class="absolute -left-5 top-8 hidden h-28 w-28 rounded-md bg-primary/10 lg:block"></div>
      <figure class="relative overflow-hidden rounded-md border border-muted-blue/35 bg-primary shadow-[0_26px_80px_rgba(15,39,82,0.18)]">
        <img
          class="aspect-[4/5] w-full object-cover object-top grayscale"
          src="/imagenes/Abogado-Saul.webp"
          alt="Saúl Cancino, abogado director de Cancino Abogados"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <aside class="relative -mt-16 ml-4 max-w-[23rem] rounded-md border border-muted-blue/35 bg-white p-5 shadow-[0_22px_60px_rgba(15,39,82,0.18)] sm:ml-8 sm:p-6 lg:absolute lg:-right-8 lg:bottom-8 lg:ml-0">
        <p class="text-sm italic leading-7 text-text-dark">
          “Combinamos litigación, estrategia y criterio empresarial para resolver asuntos jurídicos complejos con claridad.”
        </p>
        <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-primary">Saúl Cancino</p>
      </aside>
    </div>

    <div>
      <p class="eyebrow">Cancino Abogados</p>
      <h2 class="section-title max-w-4xl">Asesoría clara, estratégica y orientada a decisiones</h2>
      <p class="section-copy text-lg leading-9">
        {site.lawyer.name} dirige Cancino Abogados con foco en prevención de riesgos legales, estructuración jurídica de negocios y resolución eficiente de conflictos.
      </p>

      <div class="mt-9 grid gap-5 sm:grid-cols-3">
        {credentials.map(([label, text]) => (
          <article class="relative overflow-hidden rounded-md border border-primary/15 bg-white p-6 shadow-[0_18px_55px_rgba(15,39,82,0.1)]">
            <div class="absolute inset-x-0 top-0 h-1 bg-accent"></div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">{label}</p>
            <p class="mt-5 text-base font-semibold leading-7 text-primary">{text}</p>
          </article>
        ))}
      </div>

      <a class="btn-primary mt-8" href="/contacto/">Agendar una consulta</a>
    </div>
  </div>
</section>
