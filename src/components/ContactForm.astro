---
import { services } from "@data/services";

const fieldClass =
  "w-full min-w-0 rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition placeholder:text-primary-soft/60 focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20";
---

<form
  class="contact-form min-w-0 rounded-md border border-muted-blue/35 bg-white p-6 shadow-soft sm:p-8"
  aria-label="Formulario de contacto"
  data-contact-form
>
  <div class="border-b border-muted-blue/30 pb-6">
    <p class="eyebrow">Contacto directo</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-normal text-night sm:text-4xl">Solicitar evaluación legal</h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-primary-soft">
      Complete sus datos y recibiremos su consulta por WhatsApp con la información ordenada para coordinar los próximos pasos.
    </p>
  </div>

  <div class="mt-8 grid min-w-0 gap-5 sm:grid-cols-2">
    <label class="grid min-w-0 gap-2 text-sm font-semibold text-night">
      Nombre
      <input class={fieldClass} type="text" name="name" autocomplete="name" placeholder="Tu nombre" required />
    </label>
    <label class="grid min-w-0 gap-2 text-sm font-semibold text-night">
      Correo
      <input class={fieldClass} type="email" name="email" autocomplete="email" placeholder="tu@email.cl" required />
    </label>
    <label class="grid min-w-0 gap-2 text-sm font-semibold text-night">
      Teléfono
      <input class={fieldClass} type="tel" name="phone" autocomplete="tel" placeholder="+56 9" required />
    </label>
    <label class="grid min-w-0 gap-2 text-sm font-semibold text-night">
      Área de consulta
      <select class={`${fieldClass} truncate pr-10`} name="service" required>
        <option value="">Seleccione un área</option>
        {services.map((service) => <option value={service.title}>{service.title}</option>)}
      </select>
    </label>
    <label class="grid min-w-0 gap-2 text-sm font-semibold text-night sm:col-span-2">
      Mensaje
      <textarea
        class={`${fieldClass} min-h-44 resize-y`}
        name="message"
        placeholder="Describe brevemente tu consulta"
        required
      ></textarea>
    </label>
  </div>
  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button class="btn-primary w-full sm:w-auto" type="submit">Enviar consulta</button>
    <p class="text-xs leading-6 text-primary-soft">
      Se abrirá WhatsApp con el mensaje preparado. No envíe documentos sensibles hasta coordinar la consulta.
    </p>
  </div>
</form>

<script>
  const form = document.querySelector("[data-contact-form]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) {
      return;
    }

    const data = new FormData(form);
    const message = [
      "Hola, quiero solicitar una evaluación legal.",
      "",
      `Nombre: ${data.get("name")}`,
      `Correo: ${data.get("email")}`,
      `Teléfono: ${data.get("phone")}`,
      `Área de consulta: ${data.get("service")}`,
      "",
      `Mensaje: ${data.get("message")}`
    ].join("\n");

    const whatsappUrl = `https://wa.me/56956075464?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, "_blank", "noopener,noreferrer");
  });
</script>
