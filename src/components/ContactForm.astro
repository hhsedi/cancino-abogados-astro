---
import { services } from "@data/services";
---

<form class="rounded-md border border-muted-blue/35 bg-white p-6 shadow-soft sm:p-8" aria-label="Formulario visual de contacto">
  <div class="border-b border-muted-blue/30 pb-6">
    <p class="eyebrow">Formulario visual</p>
    <h2 class="mt-3 font-serif text-3xl font-semibold text-night">Solicitar evaluación legal</h2>
    <p class="mt-3 text-sm leading-7 text-primary-soft">
      Este formulario queda preparado para integrarse posteriormente con WordPress Headless, CRM o correo transaccional.
    </p>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold text-night">
      Nombre
      <input class="rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20" type="text" placeholder="Tu nombre" />
    </label>
    <label class="grid gap-2 text-sm font-bold text-night">
      Correo
      <input class="rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20" type="email" placeholder="tu@email.cl" />
    </label>
    <label class="grid gap-2 text-sm font-bold text-night">
      Teléfono
      <input class="rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20" type="tel" placeholder="+56 9" />
    </label>
    <label class="grid gap-2 text-sm font-bold text-night">
      Área de consulta
      <select class="rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20">
        {services.map((service) => <option>{service.title}</option>)}
      </select>
    </label>
    <label class="grid gap-2 text-sm font-bold text-night sm:col-span-2">
      Mensaje
      <textarea class="min-h-40 rounded-md border border-muted-blue/35 bg-mist/40 px-4 py-3 font-normal text-text-dark outline-none transition focus:border-accent focus:bg-white focus:ring-2 focus:ring-accent/20" placeholder="Describe brevemente tu consulta"></textarea>
    </label>
  </div>
  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button class="btn-primary" type="button">Enviar consulta</button>
    <p class="text-xs leading-6 text-primary-soft">Botón no funcional en esta fase frontend.</p>
  </div>
</form>
