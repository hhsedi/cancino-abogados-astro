---
type Props = {
  city: string;
  summary: string;
  href: string;
  keyword?: string;
};

const { city, summary, href, keyword } = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-primary/15 bg-white p-6 shadow-[0_18px_52px_rgba(15,39,82,0.09)] transition duration-300 hover:-translate-y-1 hover:border-accent/70 hover:shadow-[0_28px_76px_rgba(15,39,82,0.15)]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-primary via-accent to-primary"></div>
  <div class="pointer-events-none absolute -right-14 -top-14 h-32 w-32 rounded-full border border-accent/20"></div>

  <div class="relative flex items-start justify-between gap-5">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.2em] text-accent">Atención local</p>
      <h3 class="mt-4 font-serif text-3xl font-semibold leading-tight text-night">Abogado en {city}</h3>
    </div>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary text-white shadow-[0_14px_34px_rgba(15,39,82,0.2)] transition duration-300 group-hover:bg-accent-dark">
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z" stroke="currentColor" stroke-width="1.8" />
      </svg>
    </span>
  </div>

  {keyword && (
    <p class="relative mt-4 rounded-md border border-muted-blue/30 bg-mist px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-primary">
      {keyword}
    </p>
  )}

  <p class="relative mt-5 flex-1 text-sm font-medium leading-7 text-primary-soft">{summary}</p>

  <a class="relative mt-7 inline-flex items-center justify-between gap-3 rounded-md bg-primary px-4 py-3 text-sm font-bold text-white shadow-[0_14px_34px_rgba(15,39,82,0.16)] transition duration-300 hover:bg-accent-dark" href={href}>
    <span>Ver servicios en {city}</span>
    <span aria-hidden="true" class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-white text-primary transition duration-300 group-hover:translate-x-0.5">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
</article>
