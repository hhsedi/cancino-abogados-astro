---
import { locations } from "@data/locations";
import { services } from "@data/services";
import { site } from "@data/site";

const navItem =
  "inline-flex items-center gap-1.5 px-2.5 py-2 text-sm font-medium text-text-dark transition hover:text-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent";

const dropdownPanel =
  "invisible absolute top-full z-50 pt-4 opacity-0 translate-y-1 transition duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100";

const dropdownLink =
  "group/link flex items-start justify-between gap-4 rounded-md px-3 py-3 text-sm font-medium text-text-dark transition hover:bg-background-soft hover:text-primary focus-visible:bg-background-soft focus-visible:text-primary focus-visible:outline-none";

const mobileLink =
  "rounded-md px-3 py-3 text-sm font-medium text-text-dark transition hover:bg-mist";

const mobileChildLink =
  "rounded-md px-3 py-2.5 text-sm font-normal leading-6 text-primary-soft transition hover:bg-mist hover:text-primary";
---

<header class="sticky top-0 z-40 border-b border-muted-blue/30 bg-white shadow-[0_12px_34px_rgba(15,39,82,0.08)]">
  <div class="bg-white">
    <div class="container-page flex min-h-[5.65rem] items-center justify-between gap-5">
      <a
        href="/"
        class="site-logo group flex h-[4.75rem] w-[13rem] shrink-0 items-center justify-start sm:w-[14.5rem] lg:w-[15.5rem]"
        aria-label="Ir al inicio de Cancino Abogados"
      >
        <img
          class="max-h-[4rem] w-auto max-w-full object-contain transition duration-200 group-hover:opacity-90 sm:max-h-[4.45rem]"
          src="/imagenes/Logo-cancino-abogado.webp"
          alt="Cancino Abogados"
          width="280"
          height="92"
          loading="eager"
          decoding="async"
          onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
        />
        <span class="hidden font-serif text-xl font-semibold leading-none text-primary">
          Cancino Abogados
        </span>
      </a>

      <nav
        class="hidden items-center gap-3 xl:flex"
        aria-label="Navegación principal"
      >
        <a class={navItem} href="/">Inicio</a>
        <a class={navItem} href="/nosotros/">Nosotros</a>
        <a class={navItem} href="/trayectoria/">Trayectoria</a>

        <div class="group relative">
          <button class={navItem} type="button" aria-haspopup="true">
            Servicios
            <svg class="h-3.5 w-3.5 text-accent transition group-hover:translate-y-0.5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <div class={`${dropdownPanel} left-0 w-[22rem]`}>
            <div class="rounded-md border border-muted-blue/35 bg-white p-2 shadow-[0_24px_60px_rgba(15,39,82,0.18)] ring-1 ring-white/70">
              <p class="px-3 pb-2 pt-1 text-[0.68rem] font-bold uppercase tracking-[0.24em] text-accent">
                Áreas de práctica
              </p>
              {services.map((service) => (
                <a class={dropdownLink} href={`/${service.slug}/`}>
                  <span>{service.title}</span>
                  <span class="mt-0.5 text-accent opacity-0 transition group-hover/link:translate-x-0.5 group-hover/link:opacity-100" aria-hidden="true">
                    →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="group relative">
          <button class={navItem} type="button" aria-haspopup="true">
            Dónde estamos
            <svg class="h-3.5 w-3.5 text-accent transition group-hover:translate-y-0.5" viewBox="0 0 20 20" aria-hidden="true" fill="none">
              <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <div class={`${dropdownPanel} left-0 w-64`}>
            <div class="rounded-md border border-muted-blue/35 bg-white p-2 shadow-[0_24px_60px_rgba(15,39,82,0.18)] ring-1 ring-white/70">
              <p class="px-3 pb-2 pt-1 text-[0.68rem] font-bold uppercase tracking-[0.24em] text-accent">
                Atención local
              </p>
              {locations.map((location) => (
                <a class={dropdownLink} href={location.href ?? `/${location.slug}/`}>
                  <span>{location.city}</span>
                  <span class="mt-0.5 text-accent opacity-0 transition group-hover/link:translate-x-0.5 group-hover/link:opacity-100" aria-hidden="true">
                    →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a class={navItem} href="/faq/">FAQ</a>
        <a class={navItem} href="/blog/">Blog</a>
        <a class={navItem} href="/contacto/">Contacto</a>
      </nav>

      <a
        class="hidden items-center gap-2 rounded-md bg-primary px-5 py-3 text-[0.78rem] font-bold uppercase tracking-[0.04em] text-white shadow-[0_12px_28px_rgba(15,39,82,0.16)] transition hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent xl:inline-flex"
        href={site.whatsapp}
        target="_blank"
        rel="noreferrer"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a8.5 8.5 0 0 1-11.84 7.82L4 21l1.18-5.02A8.5 8.5 0 1 1 21 12Z"></path>
          <path d="M8.7 10.4h6.6M8.7 13.5h4.4"></path>
        </svg>
        Comunícate con nosotros
      </a>

      <button
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-muted-blue/40 bg-white text-primary shadow-[0_10px_25px_rgba(15,39,82,0.08)] transition hover:border-accent/60 hover:text-accent-dark xl:hidden"
        type="button"
        data-menu-toggle
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="h-0.5 w-5 bg-current before:block before:h-0.5 before:w-5 before:-translate-y-2 before:bg-current before:content-[''] after:block after:h-0.5 after:w-5 after:translate-y-1.5 after:bg-current after:content-['']"></span>
      </button>
    </div>
  </div>

  <div class="hidden max-h-[calc(100dvh-5.65rem)] overflow-y-auto overscroll-contain border-t border-muted-blue/35 bg-white [-webkit-overflow-scrolling:touch] xl:hidden" data-mobile-menu>
    <nav class="container-page grid gap-2 pb-28 pt-4" aria-label="Navegación móvil">
      <a class={mobileLink} href="/">Inicio</a>
      <a class={mobileLink} href="/nosotros/">Nosotros</a>
      <a class={mobileLink} href="/trayectoria/">Trayectoria</a>

      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md px-3 py-3 text-sm font-medium text-text-dark transition hover:bg-mist/70 marker:hidden">
          <span>Servicios</span>
          <svg class="h-4 w-4 text-accent transition group-open:rotate-180" viewBox="0 0 20 20" aria-hidden="true" fill="none">
            <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="grid gap-1 pb-2 pl-5 pr-1">
          {services.map((service) => (
            <a class={mobileChildLink} href={`/${service.slug}/`}>
              {service.title}
            </a>
          ))}
        </div>
      </details>

      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md px-3 py-3 text-sm font-medium text-text-dark transition hover:bg-mist/70 marker:hidden">
          <span>Dónde estamos</span>
          <svg class="h-4 w-4 text-accent transition group-open:rotate-180" viewBox="0 0 20 20" aria-hidden="true" fill="none">
            <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="grid gap-1 pb-2 pl-5 pr-1">
          {locations.map((location) => (
            <a class={mobileChildLink} href={location.href ?? `/${location.slug}/`}>
              {location.city}
            </a>
          ))}
        </div>
      </details>

      <a class={mobileLink} href="/faq/">FAQ</a>
      <a class={mobileLink} href="/blog/">Blog</a>
      <a class={mobileLink} href="/contacto/">Contacto</a>
      <a class="btn-primary mt-2" href={site.whatsapp} target="_blank" rel="noreferrer">Comunícate con nosotros</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      button?.setAttribute("aria-expanded", "false");
      menu.classList.add("hidden");
    });
  });
</script>
