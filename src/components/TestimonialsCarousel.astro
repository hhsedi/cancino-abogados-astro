---
import {
  averageRating,
  businessName,
  googleProfileUrl,
  googleReviewUrl,
  googleReviewsLabel,
  reviews,
  siteUrl,
  totalReviews
} from "@data/reviews";

const formattedAverageRating = averageRating.toFixed(1).replace(".0", "");
const previewLimit = 145;

const getInitials = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => Array.from(part)[0])
    .join("")
    .toUpperCase();

const shouldShowReadMore = (quote: string) => quote.length > previewLimit;

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: businessName,
  url: siteUrl,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: Number(averageRating.toFixed(1)),
    reviewCount: totalReviews,
    bestRating: 5,
    worstRating: 1
  },
  review: reviews.map((review) => ({
    "@type": "Review",
    author: {
      "@type": "Person",
      name: review.name
    },
    datePublished: review.datePublished,
    reviewBody: review.quote,
    publisher: {
      "@type": "Organization",
      name: review.source
    },
    reviewRating: {
      "@type": "Rating",
      ratingValue: review.rating,
      bestRating: 5,
      worstRating: 1
    }
  }))
};
---

<section class="reviews-section" aria-labelledby="reviews-title">
  <div class="reviews-container">
    <aside class="reviews-summary" aria-label="Resumen de reseñas de Google">
      <h2 id="reviews-title">{businessName}</h2>
      <div class="reviews-summary__logo">
        <img src="/imagenes/Logo-cancino-abogado.webp" alt="Cancino Abogados" loading="lazy" decoding="async" />
      </div>
      <div class="reviews-summary__rating">
        <span class="reviews-summary__average">{formattedAverageRating}</span>
        <div class="reviews-stars" aria-label={`Calificación promedio ${formattedAverageRating} de 5`}>
          {Array.from({ length: 5 }).map(() => <span aria-hidden="true">★</span>)}
        </div>
      </div>
      <p>{googleReviewsLabel}</p>
      <a class="reviews-summary__button" href={googleReviewUrl} target="_blank" rel="noopener noreferrer">
        Escribe una reseña
      </a>
    </aside>

    <div class="reviews-carousel" data-testimonials-carousel aria-label="Reseñas de clientes de Cancino Abogados">
      <button class="reviews-arrow reviews-arrow--prev" type="button" data-testimonials-prev aria-label="Ver reseñas anteriores">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="reviews-viewport" data-testimonials-viewport>
        <div class="reviews-track">
          {reviews.map((review, index) => (
            <article class="review-card" data-testimonial-card>
              <header class="review-card__header">
                <div class="review-card__avatar" aria-hidden="true">{getInitials(review.name)}</div>
                <div class="review-card__person">
                  <h3>{review.name}</h3>
                </div>
                <span class="review-card__google" aria-label={`Fuente: ${review.source}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M21.35 12.2c0-.72-.06-1.24-.18-1.78H12v3.25h5.38c-.1.81-.7 2.04-2.02 2.86l-.02.11 2.93 2.14.2.02c1.86-1.62 2.88-4 2.88-6.6Z" />
                    <path fill="#34A853" d="M12 21c2.66 0 4.9-.83 6.53-2.25l-3.11-2.28c-.83.55-1.95.94-3.42.94-2.61 0-4.83-1.62-5.62-3.87l-.12.01-3.05 2.22-.04.1C4.78 18.9 8.12 21 12 21Z" />
                    <path fill="#FBBC05" d="M6.38 13.54A5.24 5.24 0 0 1 6.1 12c0-.54.1-1.06.27-1.54l-.01-.12-3.1-2.26-.1.05A8.56 8.56 0 0 0 2.25 12c0 1.39.34 2.7.92 3.87l3.21-2.33Z" />
                    <path fill="#EA4335" d="M12 6.59c1.85 0 3.1.75 3.81 1.38l2.78-2.56C16.88 3.9 14.66 3 12 3 8.12 3 4.78 5.1 3.17 8.13l3.2 2.33C7.18 8.21 9.39 6.59 12 6.59Z" />
                  </svg>
                </span>
              </header>

              <div class="review-card__rating">
                <div class="reviews-stars" aria-label={`Calificación ${review.rating} de 5`}>
                  {Array.from({ length: 5 }).map((_, starIndex) => (
                    <span class={starIndex < review.rating ? "is-filled" : ""} aria-hidden="true">★</span>
                  ))}
                </div>
                <span class="review-card__verified" aria-label="Reseña de Google verificada">
                  <svg viewBox="0 0 18 18" aria-hidden="true">
                    <path fill="currentColor" d="m9 1.4 1.55 1.35 2.03-.36.74 1.92 1.92.74-.36 2.03L16.23 9l-1.35 1.55.36 2.03-1.92.74-.74 1.92-2.03-.36L9 16.23l-1.55-1.35-2.03.36-.74-1.92-1.92-.74.36-2.03L1.77 9l1.35-1.55-.36-2.03 1.92-.74.74-1.92 2.03.36L9 1.4Z" />
                    <path fill="#fff" d="M8.08 11.7 5.45 9.06l1.02-1.02 1.61 1.6 3.46-3.45 1.01 1.02-4.47 4.49Z" />
                  </svg>
                </span>
              </div>

              <p class={`review-card__quote ${shouldShowReadMore(review.quote) ? "is-clamped" : ""}`}>
                {review.quote}
              </p>

              <button
                class="review-card__read-more"
                type="button"
                data-review-open={index}
                aria-label={`Leer reseña completa de ${review.name}`}
              >
                Leer más
              </button>
            </article>
          ))}
        </div>
      </div>

      <button class="reviews-arrow reviews-arrow--next" type="button" data-testimonials-next aria-label="Ver más reseñas">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<dialog class="reviews-modal" data-reviews-modal aria-labelledby="reviews-modal-title">
  <div class="reviews-modal__panel">
    <button class="reviews-modal__close" type="button" data-reviews-close aria-label="Cerrar reseñas">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
    <h2 id="reviews-modal-title" class="reviews-modal__title">Reseñas de Google de Cancino Abogados</h2>
    <div class="reviews-modal__list">
      {reviews.map((review, index) => (
        <article class="reviews-modal-card" data-modal-review-index={index}>
          <header class="reviews-modal-card__header">
            <div class="review-card__avatar" aria-hidden="true">{getInitials(review.name)}</div>
            <div>
              <h3>{review.name}</h3>
              <div class="review-card__rating">
                <div class="reviews-stars" aria-label={`Calificación ${review.rating} de 5`}>
                  {Array.from({ length: 5 }).map((_, starIndex) => (
                    <span class={starIndex < review.rating ? "is-filled" : ""} aria-hidden="true">★</span>
                  ))}
                </div>
                <span class="review-card__verified" aria-label="Reseña de Google verificada">
                  <svg viewBox="0 0 18 18" aria-hidden="true">
                    <path fill="currentColor" d="m9 1.4 1.55 1.35 2.03-.36.74 1.92 1.92.74-.36 2.03L16.23 9l-1.35 1.55.36 2.03-1.92.74-.74 1.92-2.03-.36L9 16.23l-1.55-1.35-2.03.36-.74-1.92-1.92-.74.36-2.03L1.77 9l1.35-1.55-.36-2.03 1.92-.74.74-1.92 2.03.36L9 1.4Z" />
                    <path fill="#fff" d="M8.08 11.7 5.45 9.06l1.02-1.02 1.61 1.6 3.46-3.45 1.01 1.02-4.47 4.49Z" />
                  </svg>
                </span>
              </div>
            </div>
            <span class="review-card__google" aria-label={`Fuente: ${review.source}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M21.35 12.2c0-.72-.06-1.24-.18-1.78H12v3.25h5.38c-.1.81-.7 2.04-2.02 2.86l-.02.11 2.93 2.14.2.02c1.86-1.62 2.88-4 2.88-6.6Z" />
                <path fill="#34A853" d="M12 21c2.66 0 4.9-.83 6.53-2.25l-3.11-2.28c-.83.55-1.95.94-3.42.94-2.61 0-4.83-1.62-5.62-3.87l-.12.01-3.05 2.22-.04.1C4.78 18.9 8.12 21 12 21Z" />
                <path fill="#FBBC05" d="M6.38 13.54A5.24 5.24 0 0 1 6.1 12c0-.54.1-1.06.27-1.54l-.01-.12-3.1-2.26-.1.05A8.56 8.56 0 0 0 2.25 12c0 1.39.34 2.7.92 3.87l3.21-2.33Z" />
                <path fill="#EA4335" d="M12 6.59c1.85 0 3.1.75 3.81 1.38l2.78-2.56C16.88 3.9 14.66 3 12 3 8.12 3 4.78 5.1 3.17 8.13l3.2 2.33C7.18 8.21 9.39 6.59 12 6.59Z" />
              </svg>
            </span>
          </header>
          <p>{review.quote}</p>
        </article>
      ))}
    </div>
  </div>
</dialog>

<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

<script>
  const carousels = document.querySelectorAll("[data-testimonials-carousel]");
  const reviewsModal = document.querySelector("[data-reviews-modal]");
  const closeModalButton = reviewsModal?.querySelector("[data-reviews-close]");

  const openReviewsModal = (index) => {
    if (!(reviewsModal instanceof HTMLDialogElement)) return;

    if (!reviewsModal.open) {
      reviewsModal.showModal();
    }

    const target = reviewsModal.querySelector(`[data-modal-review-index="${index}"]`);
    window.setTimeout(() => {
      target?.scrollIntoView({
        block: "start",
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
      });
    }, 50);
  };

  closeModalButton?.addEventListener("click", () => {
    if (reviewsModal instanceof HTMLDialogElement) {
      reviewsModal.close();
    }
  });

  reviewsModal?.addEventListener("click", (event) => {
    if (event.target === reviewsModal && reviewsModal instanceof HTMLDialogElement) {
      reviewsModal.close();
    }
  });

  document.querySelectorAll("[data-review-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) return;
      openReviewsModal(Number(button.dataset.reviewOpen || 0));
    });
  });

  carousels.forEach((carousel) => {
    const viewport = carousel.querySelector("[data-testimonials-viewport]");
    const track = carousel.querySelector(".reviews-track");
    const cards = Array.from(carousel.querySelectorAll("[data-testimonial-card]"));
    const previousButton = carousel.querySelector("[data-testimonials-prev]");
    const nextButton = carousel.querySelector("[data-testimonials-next]");

    if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement) || cards.length === 0) {
      return;
    }

    const getStep = () => {
      const firstCard = cards[0];
      if (!(firstCard instanceof HTMLElement)) return viewport.clientWidth;

      const gapValue = Number.parseFloat(window.getComputedStyle(track).columnGap || "0");
      const gap = Number.isFinite(gapValue) ? gapValue : 0;
      return firstCard.getBoundingClientRect().width + gap;
    };

    const getActiveIndex = () => {
      const step = getStep();
      if (step <= 0) return 0;
      return Math.min(cards.length - 1, Math.max(0, Math.round(viewport.scrollLeft / step)));
    };

    const scrollToIndex = (index) => {
      viewport.scrollTo({
        left: getStep() * Math.min(cards.length - 1, Math.max(0, index)),
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
      });
    };

    const updateControls = () => {
      const maxScroll = viewport.scrollWidth - viewport.clientWidth - 2;

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.disabled = viewport.scrollLeft <= 2;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = viewport.scrollLeft >= maxScroll;
      }
    };

    let ticking = false;
    viewport.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateControls();
          ticking = false;
        });
      },
      { passive: true }
    );

    previousButton?.addEventListener("click", () => {
      scrollToIndex(getActiveIndex() - 1);
    });

    nextButton?.addEventListener("click", () => {
      scrollToIndex(getActiveIndex() + 1);
    });

    window.addEventListener("resize", updateControls, { passive: true });
    updateControls();
  });
</script>

<style>
  .reviews-section {
    background: #ffffff;
    padding: 5rem 0;
  }

  .reviews-container {
    display: grid;
    width: min(100% - 2rem, 92rem);
    margin-inline: auto;
    gap: 1.5rem;
  }

  .reviews-summary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 0.25rem;
  }

  .reviews-summary h2 {
    color: #000000;
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1.2;
  }

  .reviews-summary__logo {
    display: flex;
    width: 7rem;
    min-height: 2.45rem;
    align-items: center;
    margin-top: 0.65rem;
  }

  .reviews-summary__logo img {
    max-height: 2.35rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .reviews-summary__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.55rem;
  }

  .reviews-summary__average {
    color: #000000;
    font-size: 1rem;
    font-weight: 900;
  }

  .reviews-stars {
    display: inline-flex;
    gap: 0.08rem;
    color: #f6b400;
    font-size: 1.35rem;
    line-height: 1;
  }

  .reviews-summary p {
    margin-top: 0.45rem;
    color: #000000;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .reviews-summary__button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.42);
    border-radius: 0.35rem;
    background: #ffffff;
    padding: 0.75rem 1.45rem;
    color: #000000;
    font-size: 0.95rem;
    font-weight: 900;
    text-align: center;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .reviews-summary__button:hover {
    border-color: #0f2752;
    background: #0f2752;
    color: #ffffff;
  }

  .reviews-carousel {
    position: relative;
    min-width: 0;
  }

  .reviews-viewport {
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .reviews-viewport::-webkit-scrollbar {
    display: none;
  }

  .reviews-track {
    --review-gap: 1rem;
    display: flex;
    align-items: stretch;
    gap: var(--review-gap);
    padding: 0.15rem 0.15rem 0.6rem;
  }

  .review-card {
    display: flex;
    min-height: 15.25rem;
    flex: 0 0 100%;
    scroll-snap-align: start;
    flex-direction: column;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 0.75rem;
    background: #ffffff;
    padding: 1.35rem;
    color: #000000;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .review-card__header,
  .reviews-modal-card__header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .review-card__avatar {
    display: inline-flex;
    width: 3.1rem;
    height: 3.1rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #0f2752;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 900;
  }

  .review-card__person {
    min-width: 0;
  }

  .review-card__person h3,
  .reviews-modal-card h3 {
    overflow: hidden;
    color: #000000;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .review-card__google {
    display: inline-flex;
    width: 1.45rem;
    height: 1.45rem;
    align-items: center;
    justify-content: center;
  }

  .review-card__google svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .review-card__rating {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .review-card__rating .reviews-stars {
    font-size: 1.18rem;
  }

  .review-card__verified {
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    color: #4285f4;
  }

  .review-card__quote {
    display: block;
    margin-top: 0.9rem;
    color: #000000;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .review-card__quote.is-clamped {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .review-card__read-more {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    color: #7a7a7a;
    font-size: 0.98rem;
    font-weight: 700;
    transition: color 180ms ease;
  }

  .review-card__read-more:hover {
    color: #0f2752;
  }

  .reviews-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 999px;
    background: #ffffff;
    color: #6b7280;
    box-shadow: 0 8px 20px rgba(15, 39, 82, 0.08);
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .reviews-arrow--prev {
    left: -1.15rem;
    transform: translateY(-50%);
  }

  .reviews-arrow--next {
    right: -1.15rem;
    transform: translateY(-50%);
  }

  .reviews-arrow:hover:not(:disabled) {
    border-color: rgba(15, 39, 82, 0.45);
    color: #0f2752;
  }

  .reviews-arrow:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  .reviews-arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .reviews-modal {
    width: min(100% - 2rem, 43rem);
    max-height: min(86vh, 60rem);
    margin: auto;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .reviews-modal::backdrop {
    background: rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(1px);
  }

  .reviews-modal__panel {
    position: relative;
    max-height: min(86vh, 60rem);
    overflow-y: auto;
    padding: 0.5rem;
  }

  .reviews-modal__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .reviews-modal__close {
    position: fixed;
    top: 1.8rem;
    right: 1.8rem;
    z-index: 3;
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .reviews-modal__close svg {
    width: 2rem;
    height: 2rem;
  }

  .reviews-modal__list {
    display: grid;
    gap: 1rem;
  }

  .reviews-modal-card {
    border-radius: 0.75rem;
    background: #ffffff;
    padding: 1.35rem;
    color: #000000;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .reviews-modal-card .review-card__rating {
    margin-top: 0.55rem;
  }

  .reviews-modal-card p {
    margin-top: 1rem;
    color: #000000;
    font-size: 1.05rem;
    line-height: 1.48;
  }

  .reviews-arrow:focus-visible,
  .review-card__read-more:focus-visible,
  .reviews-summary__button:focus-visible,
  .reviews-modal__close:focus-visible {
    outline: 3px solid rgba(66, 133, 244, 0.34);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .reviews-track {
      --review-gap: 1rem;
    }

    .review-card {
      flex-basis: calc((100% - var(--review-gap)) / 2);
    }
  }

  @media (min-width: 1024px) {
    .reviews-container {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: center;
      gap: 2.25rem;
    }

    .reviews-track {
      --review-gap: 1.15rem;
    }

    .review-card {
      flex-basis: calc((100% - (var(--review-gap) * 2)) / 3);
    }

    .review-card:hover {
      transform: translateY(-2px);
      border-color: rgba(15, 39, 82, 0.25);
      box-shadow: 0 16px 40px rgba(15, 39, 82, 0.08);
    }
  }

  @media (max-width: 767px) {
    .reviews-section {
      padding: 3.8rem 0;
    }

    .reviews-summary {
      align-items: center;
      text-align: center;
    }

    .reviews-arrow--prev {
      left: -0.45rem;
    }

    .reviews-arrow--next {
      right: -0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-viewport {
      scroll-behavior: auto;
    }

    .reviews-arrow,
    .review-card,
    .review-card__read-more,
    .reviews-summary__button {
      transition: none;
    }
  }
</style>
